#!/bin/sh
set -eu

USER_AGENT="rx-probe/1"

usage() {
  printf '%s\n' \
    "usage: crates/rx/scripts/probe-rx-provider --base-url <url> --api-key <key>" \
    "" \
    "Live admission probe for a candidate rx provider. Requires curl and jq." \
    "" \
    "  --base-url URL         OpenAI-compatible /v1 or /v4 endpoint (or RX_PROVIDER_URL)" \
    "  --api-key KEY          API key (or RX_PROVIDER_KEY)" \
    "  --openai-model ID      model for /v1/chat/completions and /v1/responses" \
    "  --claude-model ID      model for /v1/messages" \
    "  --anthropic-base URL   Anthropic Messages base (or RX_PROVIDER_ANTHROPIC_BASE)" \
    "  --json                 machine-readable result"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf '%s\n' "$1 is required" >&2
    exit 2
  fi
}

need_value() {
  if [ $# -lt 2 ]; then
    printf '%s\n' "$1 requires a value" >&2
    exit 2
  fi
}

trim_slash() {
  printf '%s' "$1" | sed 's:/*$::'
}

openai_base() {
  trimmed=$(trim_slash "$1")
  case $trimmed in
    */v[0-9] | */v[0-9][0-9]) printf '%s\n' "$trimmed" ;;
    *) printf '%s/v1\n' "$trimmed" ;;
  esac
}

origin_base() {
  trimmed=$(trim_slash "$1")
  case $trimmed in
    */v1) printf '%s\n' "${trimmed%/v1}" ;;
    *) printf '%s\n' "$trimmed" ;;
  esac
}

anthropic_base() {
  origin_base "$1"
}

http_status() {
  awk 'toupper($1) ~ /^HTTP\// { code=$2 } END { print code }' "$1"
}

preview() {
  tr '\n' ' ' <"$1" | awk '{
    if (length($0) <= 200) print $0
    else print substr($0, 1, 200) "..."
  }'
}

stream_succeeded() {
  jq -Rse --arg protocol "$2" '
    def text: type == "string" and length > 0;
    gsub("\r\n"; "\n") | split("\n\n")
    | if last | test("[^\n]") then error("unterminated SSE frame") else .[:-1] end
    | map(split("\n")
        | {event: (map(select(startswith("event:")) | ltrimstr("event:") | ltrimstr(" ")) | last),
           data: (map(select(startswith("data:")) | ltrimstr("data:") | ltrimstr(" ")) | join("\n"))}
        | if .event == "error" then error("SSE error") else . end
        | select(.data != "")
        | if .data == "[DONE]" then {type: "done"}
          else . as $frame | .data | fromjson
          | if type != "object" then error("invalid SSE data")
            elif $frame.event != null and $frame.event != "message" and $frame.event != .type
            then error("SSE event type mismatch") else . end end)
    | if any(.error != null or .response.error != null or .type == "error" or .type == "response.failed"
        or .type == "response.incomplete") then false
      elif $protocol == "chat_completions" then
        last.type == "done"
        and any(.object == "chat.completion.chunk"
          and any(.choices[]?; .index == 0 and (.delta.content | text)))
        and any(.object == "chat.completion.chunk"
          and any(.choices[]?; .index == 0 and (.finish_reason == "stop" or .finish_reason == "length")))
      elif $protocol == "responses" then
        last.type == "response.completed" and last.response.status == "completed"
        and any(.type == "response.output_text.delta" and (.delta | text))
      elif $protocol == "messages" then
        last.type == "message_stop"
        and any(.type == "message_start" and .message.role == "assistant")
        and any(.type == "content_block_delta" and .delta.type == "text_delta" and (.delta.text | text))
        and any(.type == "message_delta" and
          (.delta.stop_reason == "end_turn" or .delta.stop_reason == "max_tokens" or .delta.stop_reason == "stop_sequence"))
      else false end
  ' "$1" >/dev/null 2>&1
}

looks_like_json() {
  awk '
    NF {
      line = $0
      sub(/^[ \t\r]+/, "", line)
      if (line ~ /^[\[{]/) found = 1
      exit
    }
    END { if (!found) exit 1 }
  ' "$1"
}

fail_auth() {
  printf '%s\n' "AUTH_FAILED: provider returned HTTP 401" >&2
  exit 2
}

record() {
  jq -nc --arg id "$1" --argjson pass "$2" --arg detail "$3" \
    '{id:$id, pass:($pass == 1), detail:$detail}' >>"$results"
}

data_ids() {
  jq -r '.data[]? | select(.id | type == "string") | .id' "$1" 2>/dev/null || true
}

count_lines() {
  if [ -s "$1" ]; then
    wc -l <"$1" | tr -d ' '
  else
    printf '0\n'
  fi
}

pick_openai_model() {
  if [ -n "$openai_model" ]; then
    printf '%s\n' "$openai_model"
    return
  fi
  picked=$(awk '{ if (tolower($0) !~ /claude|anthropic/) { print; exit } }' "$1")
  if [ -n "$picked" ]; then
    printf '%s\n' "$picked"
    return
  fi
  awk 'NF { print; exit }' "$1"
}

pick_claude_model() {
  if [ -n "$claude_model" ]; then
    printf '%s\n' "$claude_model"
    return
  fi
  picked=$(awk '{ if (tolower($0) ~ /claude|anthropic/) { print; exit } }' "$@")
  if [ -n "$picked" ]; then
    printf '%s\n' "$picked"
    return
  fi
  awk 'NF { print; exit }' "$@"
}

curl_get() {
  url=$1
  shift
  if ! curl -sS --max-time 15 -D "$hdr" -o "$body" \
    -H "Authorization: Bearer ${api_key}" \
    -H "User-Agent: ${USER_AGENT}" \
    -H "Accept: application/json" \
    "$@" \
    "$url" >/dev/null
  then
    status=""
    return 0
  fi
  status=$(http_status "$hdr")
  if [ "$status" = "401" ]; then
    fail_auth
  fi
}

check_catalog_data() {
  name=$1
  url=$2
  dest=$3
  shift 3
  : >"$dest"
  curl_get "$url" "$@"
  if [ -z "$status" ]; then
    record "$name" 0 "request failed"
    return 0
  fi
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    record "$name" 0 "HTTP ${status}: $(preview "$body")"
    return 0
  fi
  if ! jq -e '.data | type == "array"' "$body" >/dev/null 2>&1; then
    record "$name" 0 "missing data[]"
    return 0
  fi
  data_ids "$body" >"$dest"
  n=$(count_lines "$dest")
  if [ "$n" = "0" ]; then
    record "$name" 0 "data[] has no id"
    return 0
  fi
  record "$name" 1 "${n} models"
}

curl_stream() {
  url=$1
  payload=$2
  shift 2
  : >"$body"
  : >"$hdr"
  : >"$err"
  stream_exit=0
  curl -sS -N --max-time 8 -D "$hdr" -o "$body" \
    -H "Authorization: Bearer ${api_key}" \
    -H "User-Agent: ${USER_AGENT}" \
    -H "Content-Type: application/json" \
    -H "Accept: text/event-stream" \
    "$@" \
    -d "$payload" \
    "$url" >/dev/null 2>"$err" || stream_exit=$?
  status=$(http_status "$hdr")
  if [ "$status" = "401" ]; then
    fail_auth
  fi
}

check_stream() {
  name=$1
  url=$2
  payload=$3
  label=$4
  shift 4
  curl_stream "$url" "$payload" "$@"
  if [ -z "$status" ]; then
    if [ -s "$err" ]; then
      record "$name" 0 "$(preview "$err")"
    else
      record "$name" 0 "request failed"
    fi
    return 0
  fi
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    record "$name" 0 "HTTP ${status}: $(preview "$body")"
    return 0
  fi
  if [ "$stream_exit" -ne 0 ]; then
    record "$name" 0 "stream request failed: $(preview "$err")"
    return 0
  fi
  if ! awk '
    toupper($1) ~ /^HTTP\// { media_type = "" }
    tolower($0) ~ /^content-type:/ {
      media_type = tolower($0)
      sub(/^content-type:[ \t]*/, "", media_type)
      sub(/[; \t\r].*$/, "", media_type)
    }
    END { exit (media_type != "text/event-stream") }
  ' "$hdr"; then
    record "$name" 0 "expected Content-Type text/event-stream"
    return 0
  fi
  if stream_succeeded "$body" "$name"; then
    record "$name" 1 "completed SSE text ${label}"
    return 0
  fi
  if looks_like_json "$body"; then
    record "$name" 0 "non-streaming JSON; Codex/Claude require SSE"
    return 0
  fi
  record "$name" 0 "no successful ${name} SSE completion"
}

base_url=${RX_PROVIDER_URL:-${RX_PROVIDER_BASE_URL:-}}
api_key=${RX_PROVIDER_KEY:-${RX_PROVIDER_API_KEY:-}}
openai_model=""
claude_model=""
anthropic_base_url=${RX_PROVIDER_ANTHROPIC_BASE:-}
json=0

while [ $# -gt 0 ]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    --base-url)
      need_value "$@"
      base_url=$2
      shift 2
      ;;
    --base-url=*)
      base_url=${1#*=}
      shift
      ;;
    --api-key)
      need_value "$@"
      api_key=$2
      shift 2
      ;;
    --api-key=*)
      api_key=${1#*=}
      shift
      ;;
    --openai-model)
      need_value "$@"
      openai_model=$2
      shift 2
      ;;
    --openai-model=*)
      openai_model=${1#*=}
      shift
      ;;
    --claude-model)
      need_value "$@"
      claude_model=$2
      shift 2
      ;;
    --claude-model=*)
      claude_model=${1#*=}
      shift
      ;;
    --anthropic-base)
      need_value "$@"
      anthropic_base_url=$2
      shift 2
      ;;
    --anthropic-base=*)
      anthropic_base_url=${1#*=}
      shift
      ;;
    --json)
      json=1
      shift
      ;;
    *)
      printf '%s\n' "unexpected argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$base_url" ]; then
  printf '%s\n' "missing --base-url (or RX_PROVIDER_URL)" >&2
  exit 2
fi
if [ -z "$api_key" ]; then
  printf '%s\n' "missing --api-key (or RX_PROVIDER_KEY)" >&2
  exit 2
fi

require_cmd curl
require_cmd jq

v1=$(openai_base "$base_url")
origin=$(origin_base "$base_url")
if [ -n "$anthropic_base_url" ]; then
  claude_origin=$(anthropic_base "$anthropic_base_url")
else
  claude_origin=$origin
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
hdr=$work/hdr
body=$work/body
err=$work/err
openai_ids=$work/openai_ids
results=$work/results
status=""
: >"$results"

check_catalog_data openai_models "${v1}/models" "$openai_ids"

openai_pick=$(pick_openai_model "$openai_ids")
claude_pick=$(pick_claude_model "$openai_ids")

if [ -z "$openai_pick" ]; then
  record chat_completions 0 "no OpenAI model id"
  record responses 0 "no OpenAI model id"
else
  chat_body=$(jq -nc --arg model "$openai_pick" \
    '{model:$model,messages:[{role:"user",content:"ping"}],max_tokens:1,stream:true}')
  responses_body=$(jq -nc --arg model "$openai_pick" \
    '{model:$model,input:"ping",max_output_tokens:16,store:false,stream:true}')
  check_stream chat_completions "${v1}/chat/completions" "$chat_body" "$openai_pick"
  check_stream responses "${v1}/responses" "$responses_body" "$openai_pick"
fi

if [ -z "$claude_pick" ]; then
  record messages 0 "no Claude model id"
else
  messages_body=$(jq -nc --arg model "$claude_pick" \
    '{model:$model,max_tokens:16,stream:true,messages:[{role:"user",content:"ping"}]}')
  check_stream messages "${claude_origin}/v1/messages" "$messages_body" "$claude_pick" \
    -H "anthropic-version: 2023-06-01"
fi

if jq -s -e '
  ["openai_models", "chat_completions", "responses", "messages"] as $need
  | map(select(.id as $id | $need | index($id)))
  | length == ($need | length) and all(.pass)
' "$results" >/dev/null; then
  verdict=ADMIT
else
  verdict=REJECT
fi

if [ "$json" -eq 1 ]; then
  jq -s --arg base_url "$v1" --arg anthropic_base "$claude_origin" --arg verdict "$verdict" \
    '{base_url:$base_url, anthropic_base:$anthropic_base, verdict:$verdict, checks:.}' "$results"
else
  printf 'base_url: %s\n' "$v1"
  printf 'anthropic_base: %s\n' "$claude_origin"
  jq -r '"\(.id)\t\(if .pass then "PASS" else "FAIL" end)\t\(.detail)"' "$results" |
    awk -F '\t' '{ printf "%-20s  %s  %s\n", $1, $2, $3 }'
  printf '%s\n' "$verdict"
fi

if [ "$verdict" = "ADMIT" ]; then
  exit 0
fi
exit 1
